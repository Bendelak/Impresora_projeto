BASE_DIR = Path(__file__).resolve().parent   # independe de onde o atalho abre
PASTA_CSV = BASE_DIR / "CSV"
LOG_VALES = BASE_DIR / "logs" / "vales.csv"

MAX_SENHAS = 500
MAX_COPIAS_WIFI = 20

WIFI_REDE_PADRAO = "Clientes Posto 44"
WIFI_SENHA_PADRAO = "posto442025"

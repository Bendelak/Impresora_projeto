class Tela:

    def __init__(self):
        self.imp = Impressora()
        self.janela = tk.Tk()

        self.fonte_var = tk.StringVar(value="Média (2x2)")
        self.cabecalho_var = tk.StringVar(value="")

        self.fila = queue.Queue()     # worker -> interface
        self.botoes = []
        self.ocupado = False
        self._avanco = None
        self._detalhe_falha = ""

        self._configurar_janela()
        self._criar_cabecalho()
        self._criar_status()          # antes das abas: nunca fica cortado
        self._criar_abas()

        self.janela.report_callback_exception = self._erro_inesperado
        self.janela.protocol("WM_DELETE_WINDOW", self._fechar)
        self.janela.after(100, self._processar_fila)

    def executar(self):
        self.janela.mainloop()

    # --------------------------------------------------------
    # Janela
    # --------------------------------------------------------

    def _configurar_janela(self):
        self.janela.title("Sistema de Impressão")

        largura, altura = 800, 650
        pos_x = (self.janela.winfo_screenwidth() - largura) // 2
        pos_y = (self.janela.winfo_screenheight() - altura) // 2

        self.janela.geometry(f"{largura}x{altura}+{pos_x}+{pos_y}")
        self.janela.resizable(False, False)
        self.janela.configure(bg=COR_FUNDO)

    def _configurar_estilo(self):
        estilo = ttk.Style()
        estilo.theme_use("clam")

        estilo.configure("TNotebook", background="#2b2b2b", borderwidth=0)
        estilo.configure(
            "TNotebook.Tab",
            background="#3a3a3a",
            foreground="white",
            padding=(15, 5),
            font=("Segoe UI", 10, "bold"),
        )
        estilo.map(
            "TNotebook.Tab",
            background=[("selected", "#d71920")],
            foreground=[("selected", "white")],
        )

    def _criar_cabecalho(self):
        cabecalho = tk.Frame(self.janela, bg=COR_CABECALHO)
        cabecalho.pack(fill="x")

        tk.Label(
            cabecalho,
            textvariable=self.cabecalho_var,
            bg=COR_CABECALHO,
            fg="white",
            font=("Arial", 24, "bold"),
        ).pack(pady=(10, 0))

        tk.Label(
            cabecalho,
            text="Sistema de Impressão",
            bg=COR_CABECALHO,
            fg="white",
            font=("Arial", 12),
        ).pack()

        controles = tk.Frame(cabecalho, bg=COR_CABECALHO)
        controles.pack(pady=10)

        tk.Label(controles, text="Cabeçalho:", bg=COR_CABECALHO, fg="white") \
            .grid(row=0, column=0, padx=5)

        tk.Entry(controles, textvariable=self.cabecalho_var, width=25) \
            .grid(row=0, column=1, padx=5)

        tk.Label(controles, text="Fonte:", bg=COR_CABECALHO, fg="white") \
            .grid(row=0, column=2, padx=5)

        ttk.Combobox(
            controles,
            textvariable=self.fonte_var,
            values=list(self.imp.tamanhos),
            state="readonly",
            width=18,
        ).grid(row=0, column=3, padx=5)

    def _criar_status(self):
        self.status = tk.Label(
            self.janela, text="", bg="#1F1F1F", anchor="w", padx=10
        )
        self.status.pack(fill="x", side="bottom")
        self._status("Sistema pronto.")

    def _status(self, texto, tipo="ok"):
        icone, cor = STATUS[tipo]
        self.status.config(text=f"{icone} {texto}", fg=cor)

    # --------------------------------------------------------
    # Abas
    # --------------------------------------------------------

    def _criar_abas(self):
        self._configurar_estilo()

        self.notebook = ttk.Notebook(self.janela)
        self.notebook.pack(fill="both", expand=True, padx=20, pady=20)

        self._montar_aba_texto()
        self._montar_aba_banho()
        self._montar_aba_vale()
        self._montar_aba_calculadora()
        self._montar_aba_wifi()

    def _nova_aba(self, titulo):
        aba = tk.Frame(self.notebook, bg=COR_ABA)
        self.notebook.add(aba, text=titulo)
        return aba

    def _criar_dica(self, pai, texto):
        tk.Label(pai, text=texto, bg=COR_ABA, fg="#bbbbbb", font=("Arial", 9)) \
            .pack(pady=(12, 3))

    def _criar_caixa(self, pai, largura, altura):
        caixa = tk.Text(pai, font=("Arial", 10, "bold"), width=largura, height=altura)
        caixa.pack(pady=(0, 8))
        return caixa

    def _criar_botao(self, pai, texto, comando):
        botao = tk.Button(
            pai,
            text=texto,
            font=("Arial", 14, "bold"),
            bg=COR_BOTAO,
            fg="white",
            activebackground="#218838",
            activeforeground="white",
            disabledforeground="#dddddd",
            width=22,
            height=2,
            relief="flat",
            cursor="hand2",
            command=comando,
        )
        botao.pack(pady=12)
        self.botoes.append(botao)
        return botao

    def _montar_aba_texto(self):
        aba = self._nova_aba("Texto")
        self._criar_dica(aba, "Uma impressão por linha (o cabeçalho vai acima de cada uma).")
        self.caixa_texto = self._criar_caixa(aba, 50, 12)
        self._criar_botao(aba, "🖨 IMPRIMIR", self.imprimir_texto)

    def _montar_aba_banho(self):
        aba = self._nova_aba("Banho")
        self._criar_dica(aba, f"Quantidade de senhas (1 a {MAX_SENHAS}). "
                              "Os códigos também são salvos na pasta CSV.")
        self.entrada_banho = tk.Entry(
            aba, font=("Arial", 16, "bold"), width=8, justify="center"
        )
        self.entrada_banho.pack(pady=(0, 10))
        self.entrada_banho.bind("<Return>", lambda _e: self.imprimir_banho())
        self._criar_botao(aba, "🖨 IMPRIMIR", self.imprimir_banho)

    def _montar_aba_vale(self):
        aba = self._nova_aba("Vale")
        self._criar_dica(aba, "Um valor por linha (um vale para cada linha).")
        self.caixa_vale = self._criar_caixa(aba, 60, 12)
        self._criar_botao(aba, "🖨 IMPRIMIR", self.imprimir_vale)

    def _montar_aba_calculadora(self):
        aba = self._nova_aba("Calculadora")
        self._criar_dica(aba, "Um valor por linha. Use sinal de menos para subtrair.")
        self.caixa_calculadora = self._criar_caixa(aba, 50, 8)

        self.resultado_calculadora = tk.Label(
            aba,

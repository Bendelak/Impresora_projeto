    def _montar_aba_wifi(self):
        aba = self._nova_aba("WiFi")
        self._criar_dica(aba, "Imprime o nome da rede, a senha e o QR Code de conexão.")

        campos = tk.Frame(aba, bg=COR_ABA)
        campos.pack(pady=10)

